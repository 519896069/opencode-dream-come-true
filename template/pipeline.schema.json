{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["stages"],
  "properties": {
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "name", "skill", "artifacts", "effort", "aiReview", "parallel"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "skill": { "type": "string" },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "effort": { "type": "string", "enum": ["high", "max", "medium"] },
          "aiReview": { "type": ["boolean", "string"], "enum": [true, false, "skip"] },
          "parallel": { "type": "boolean" }
        }
      }
    }
  }
}
